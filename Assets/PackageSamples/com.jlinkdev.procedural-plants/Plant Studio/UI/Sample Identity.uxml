<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="inspector-backdrop" class="sample-inspector-backdrop" picking-mode="Ignore" />
    <ui:VisualElement class="sample-identity" picking-mode="Ignore">
        <ui:VisualElement class="sample-identity-content" picking-mode="Ignore">
            <ui:VisualElement class="sample-identity-gradient" picking-mode="Ignore" />
            <ui:Label class="sample-symbol" text="&#xea35;" picking-mode="Ignore" />
            <ui:VisualElement picking-mode="Ignore">
                <ui:Label name="package-name" class="sample-package" text="Procedural Plants" picking-mode="Ignore" />
                <ui:Label name="sample-name" class="sample-name" text="Plant Studio" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
