<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="sample-identity" picking-mode="Ignore">
        <ui:VisualElement class="sample-identity-content" picking-mode="Ignore">
            <ui:VisualElement class="sample-identity-gradient" picking-mode="Ignore" />
            <ui:Label class="sample-symbol" text="&#xf04e;" picking-mode="Ignore" />
            <ui:VisualElement picking-mode="Ignore">
                <ui:Label name="package-name" class="sample-package" text="World Scanning" picking-mode="Ignore" />
                <ui:Label name="sample-name" class="sample-name" text="World Scan Demo" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
