#pragma kernel BuildDensity
#pragma kernel BuildDetail
#pragma kernel StarOpticalDepth

#include "NebulaDensity.hlsl"
RWTexture3D<float> _Output;
RWTexture3D<float4> _MediumOutput;
int _Resolution;
int _Seed;
int _ForegroundShelf;
int _VaryBankLayout;
float4x4 _FrontBank, _RearBank, _ShelfBank;
float4x4 _ArcSweep, _ArcShoulder, _ArcHook, _ArcCanopy;
float3 _ArcShape;
float3 _BankBend;
float _RearCrease;
float _BankScale, _Coverage;
float _PlumeScale;
Texture3D<float> _ShapeTexture;
float _ShapeDisplacement;
float3 _StarUVW;

uint mixBits(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    return x ^ (x >> 16);
}

float hash(float3 cell)
{
    uint3 p = asuint(int3(cell));
    return (mixBits(p.x * 73856093u ^ p.y * 19349663u ^ p.z * 83492791u ^ uint(_Seed)) >> 8) / 16777216.0;
}

float noise3(float3 p)
{
    float3 b = floor(p), t = frac(p);
    t = t*t*(3-2*t);
    float4 plane0 = float4(hash(b),hash(b+float3(1,0,0)),hash(b+float3(0,1,0)),hash(b+float3(1,1,0)));
    b.z += 1;
    float4 plane1 = float4(hash(b),hash(b+float3(1,0,0)),hash(b+float3(0,1,0)),hash(b+float3(1,1,0)));
    float4 v = lerp(plane0,plane1,t.z);
    return lerp(lerp(v.x,v.y,t.x),lerp(v.z,v.w,t.x),t.y);
}

// Tileable, domain-warped cellular noise gives close banks scalloped silhouettes.
// Each periodic cell contains one deterministic feature point.
float cellular(float3 p, int period)
{
    int3 cell = int3(floor(p));
    float nearest = 4;
    for (int z=-1;z<=1;z++) for (int y=-1;y<=1;y++) for (int x=-1;x<=1;x++)
    {
        int3 offset = int3(x,y,z);
        // The two-period bias covers the curl and the neighbor offset, so indices are positive.
        uint3 wrapped = (uint3)(cell + offset + period*2) % (uint)period;
        float3 feature = float3(hash(wrapped),hash(wrapped+73),hash(wrapped+31));
        float3 v = offset + .1 + .8*feature - frac(p);
        nearest = min(nearest,dot(v,v));
    }
    return saturate(sqrt(nearest));
}

[numthreads(4,4,4)]
void BuildDetail(uint3 id : SV_DispatchThreadID)
{
    float3 q = (id+.5)/_Resolution;
    float3 curl = .075*sin(6.2831853*(q.yzx+sin(6.2831853*q.zxy)*.27));
    float3 p = q+curl;
    _Output[id] = .65*cellular(p*7,7) + .25*cellular(p*14,14) + .1*cellular(p*28,28);
}

// The two coordinates transverse to a lane control its thickness and its depth.
// Their intersection produces ropes; broader depth envelopes produce folded sheets.
float4 dustLane(float3 p, float phase)
{
    float3 n = p * _BankScale + phase;
    float3 bend = float3(noise3(n*.72+3),noise3(n*.72+11),noise3(n*.72+23))-.5;
    n += bend*1.8;
    float fold = .25*(noise3(n*1.1)-.5) + .09*(noise3(n*2.7+9)-.5);
    fold += _Wisps*(.040*(noise3(n*6.3+14)-.5)+.015*(noise3(n*13.1+27)-.5));
    float u = p.y + .38*p.z + fold;
    float v = p.z - .18*sin(5*p.x+phase) + .33*bend.z + .08*(noise3(n*2.2+36)-.5);
    float width = lerp(.022,.105,_Coverage);
    float envelope = exp2(-v*v/.016) * smoothstep(.14,.59,noise3(n*.63+8)+.16*_Coverage);
    float core = exp2(-u*u/(width*width*.42));
    float fork = u - .11*(noise3(n*.85+31)-.24);
    float branch = exp2(-fork*fork/(width*width*.10));
    float dust = envelope*(core*.88+branch*.62);
    // A luminous front and finer strands lie along one side of the cold lane.
    float front = (u-width*(1.1+.65*bend.y))/width;
    float glow = exp2(-front*front*4.2) + .45*exp2(-pow(abs(front-.70),2)*19);
    return float4(dust, envelope*(glow+.30*exp2(-front*front*.32)),u,v);
}

float massEnvelope(float3 delta, float3 extent)
{
    float3 d = delta/extent;
    return exp2(-dot(d,d)*1.65);
}

// Three differently oriented envelopes give the camera foreground, middle and
// distant material. The shared warped field splits each into irregular lobes.
float2 cloudMass(float3 p)
{
    float3 n = p*_BankScale;
    float3 bend = float3(noise3(n*.8+9),noise3(n*.8+23),noise3(n*.8+41))-.5;
    float3 warped = p+.21*bend;
    float3 farMass = warped-float3(.04,-.09,.28);
    farMass.y += .32*farMass.x-.23*farMass.z;
    float3 overhead = warped-float3(-.21,.17,.055);
    overhead.x += .50*overhead.y+.36*overhead.z;
    float3 nearFold = warped-float3(.16,-.02,-.045);
    nearFold.z += .58*nearFold.x-.28*nearFold.y;
    float envelope = max(massEnvelope(farMass,float3(.55,.29,.26)),
                         massEnvelope(overhead,float3(.20,.34,.22)));
    envelope = max(envelope,.84*massEnvelope(nearFold,float3(.28,.23,.085)));
    n += 1.85*bend;
    float grain = .52*noise3(n*1.48)+.26*noise3(n*3.17+5)+.15*noise3(n*6.73+11)+.07*noise3(n*14.9+21);
    float level = envelope+1.50*(grain-.49)-lerp(.79,.24,_Coverage);
    // Cavities leave broken, folded walls inside the mass. Their thickness
    // varies along the fold so that the projected shape breaks into wisps.
    float fold = grain-.48+.17*(noise3(n*.91+48)-.5);
    float wall = exp2(-fold*fold*235)*smoothstep(.13,.58,envelope);
    float body = saturate(level*2.4)*(.13+.95*wall);
    float3 veil = warped-float3(.085,.055,-.04);
    veil.y -= .65*veil.x+.045*(noise3(n*2.6+15)-.5);
    float nearDust = massEnvelope(veil,float3(.18,.053,.076));
    body += nearDust*smoothstep(.28,.66,grain)*1.25;
    float fringe = exp2(-75*(level-.10)*(level-.10))*smoothstep(.18,.59,envelope);
    return float2(body*(.52+.70*grain),body*.38+fringe*.48);
}

// A broken molecular shell presents different illuminated faces as the camera
// moves around it. Its nearer lip crosses the more diffuse gas in the cavity.
float4 emissionCavity(float3 p)
{
    float3 n = p*_BankScale + 2.3*_FormShift;
    float3 bend = float3(noise3(n*1.18+5),noise3(n*1.18+22),noise3(n*1.18+61))-.5;
    n += 1.6*bend;
    float3 twist = float3(noise3(n*2.7+15),noise3(n*2.7+32),noise3(n*2.7+47))-.5;
    float grain = .51*noise3(n*2.5)+.27*noise3(n*5.3+19)+.15*noise3(n*11.4+9)+.07*noise3(n*22.3+35);
    float3 w = p+.145*bend+_Wisps*(.074*twist+.035*(grain-.5));
    float3 bubble = w-float3(.12,-.026,.205);
    bubble.x -= .43*bubble.y+.32*bubble.z;
    float r = length(bubble/float3(.235,.168,.21))+.67*(grain-.5);
    float shell = exp2(-45*(r-1)*(r-1));
    float3 bank = w-float3(-.13,.04,.11);
    bank.x += .37*bank.z-.38*bank.y;
    float core = massEnvelope(bank,float3(.22,.46,.23));
    float3 lip = w-float3(.01,-.058,.065);
    lip.y += .44*lip.x-.85*lip.x*lip.x+.48*lip.z;
    float overhang = massEnvelope(lip,float3(.24,.032,.096));
    float3 pocket = w-float3(-.037,.067,.13);
    float violet = massEnvelope(pocket,float3(.077,.072,.095));
    float breakup = smoothstep(.29,.66,grain+.19*(_Coverage-.6));
    float dust = (.77*shell+1.0*core+2.7*overhang)*(.045+1.62*breakup);
    dust *= (1-.82*smoothstep(.055,.66,violet))*lerp(.46,1.24,_Coverage);
    float hot = exp2(-1.75*r*r)*(.06+.92*breakup);
    float rim = exp2(-140*(r-.83)*(r-.83))*(.15+2.2*breakup);
    float haze = .20*massEnvelope(w-float3(.12,.01,.29),float3(.48,.38,.24));
    float gas = (hot+rim+haze)*(.36+.80*_CloudBody)+2.1*violet*(.12+1.6*breakup);
    // An eroded foreground sheet intercepts the hot interior. Its thickness
    // and its broken outline vary independently along the sheet.
    float3 sheetUV = float3(p.xy*_BankScale*3.8,17.4);
    sheetUV.xy += float2(noise3(sheetUV*.55+3),noise3(sheetUV*.55+19))*1.9;
    float curl = noise3(sheetUV)-.5;
    float ripple = noise3(sheetUV*2.17+8)-.5;
    float fray = noise3(sheetUV*5.13+11)-.5;
    // Folds in the far wall have a much larger projected area than the
    // nearby lip. Concentrate excited gas along their corrugated surfaces.
    float3 back = p-float3(.116,-.018,.205);
    float patch = massEnvelope(back,float3(.25,.18,.22));
    float relief = curl+.55*ripple+.29*fray;
    float backZ = back.z-.22*back.x+.31*back.y-.088*relief;
    float front = exp2(-backZ*backZ*1150)*patch;
    float ridges = exp2(-pow(abs((relief-.11)/.085),2));
    gas = gas*.75 + front*(.28+5.4*ridges+2.1*smoothstep(.01,.46,relief));
    dust += front*2.1*smoothstep(.02,.34,-relief);
    float contour = p.y+.26*p.x+.033 + .11*curl+.052*ripple+.023*fray;
    float sheetZ = p.z-.082-.20*p.x-.105*curl-.043*ripple;
    float sheet = exp2(-sheetZ*sheetZ*2800)*exp2(-p.x*p.x*19);
    float tongue = exp2(-contour*contour*1540);
    dust += sheet*tongue*(.65+3.6*smoothstep(-.19,.23,curl+ripple*.72));
    gas += sheet*exp2(-pow(abs(contour-.032),2)*2700)*(.45+2.9*breakup);
    // A branching column protrudes into the cavity from one side. Slice
    // detail across the column so narrow curls survive line integration.
    float edgeNoise = .021*(noise3(sheetUV*3.5+43)-.5)+.010*(noise3(sheetUV*8.4+6)-.5);
    float spine = p.y+.037+.25*p.x+.018*sin(p.x*31)+.055*curl+.032*ripple+edgeNoise;
    float tip = smoothstep(.015,.095,p.x+.047*curl);
    float stem = abs(spine)-(.004+.014*tip);
    float fork = abs(spine-.42*(p.x-.096))-(.004+.007*tip);
    float surface = min(stem,fork+.032*smoothstep(.13,.23,p.x));
    float branch = exp2(-pow(abs((p.z-.096-.24*p.x-.025*curl)/.037),2));
    branch *= smoothstep(.007,.066,p.x+.032*curl)*(1-smoothstep(.20,.37,p.x));
    dust += 4.2*branch*(1-smoothstep(-.005,.008,surface));
    gas += 2.6*branch*exp2(-pow(abs((surface-.008)/.006),2));
    float frontFade = lerp(.14,1,smoothstep(-.09,.065,p.z+.06*bend.z));
    dust *= frontFade;
    gas *= frontFade;
    // This folded interface slopes back through the volume. Baked signed
    // distance lets the marcher resolve its fine edges between cache voxels.
    float fold = p.y+.29*p.x+.53*p.z-.028 + .23*bend.y + .108*twist.x + .12*(grain-.5);
    return float4(dust,gas,smoothstep(.08,.57,violet),fold);
}

float4 cloudAndLanes(float3 p)
{
    float angle = lerp(.25,.91,hash(float3(39,7,21)));
    float s,c;
    sincos(angle,s,c);
    float3 lane = float3(c*p.x+s*p.y,-s*p.x+c*p.y,p.z);
    float4 medium = dustLane(lane-float3(0,-.05,.19),2.4);
    float3 spur = float3(.76*lane.x-.65*lane.y,.65*lane.x+.76*lane.y,lane.z);
    // A nearer, predominantly absorbing lane crosses the emitting gas at a
    // different angle. It can occult both the distant stars and the lit front.
    float2 foreground = dustLane(spur-float3(.14,.065,-.075),13.1).xy;
    medium.xy += float2(1.85*pow(foreground.x,1.65),.20*foreground.y);
    medium.xy = lerp(medium.xy,cloudMass(p),_CloudBody);
    return medium;
}

// Lobes grow along a curved spine. Smaller lobes overlap their shoulders at
// different depths, leaving recesses that can fall into real stellar shadow.
float plumeDistance(float3 p, float3 root, float3 tip, float3 bow, float radius, float phase)
{
    float3 axis = normalize(tip-root);
    float3 side = normalize(cross(axis,float3(0,0,1)));
    float3 front = cross(axis,side);
    float distance = 2;
    [unroll] for (int i=0;i<6;i++)
    {
        float t = i*.2;
        float3 spine = lerp(root,tip,t) + bow*(4*t*(1-t));
        float angle = phase+2.40*i+dot(_FormShift,float3(3.3,2.4,-2.8))*sin(phase+t*2);
        float3 radial = cos(angle)*side + sin(angle)*front;
        float r = radius*(.80+.25*sin(t*2.7)+.13*cos(angle))*_PlumeScale;
        float3 lobe = spine+.61*r*radial;
        distance = min(distance,length(p-lobe)-r);
        float3 bud = lobe+r*(.87*radial+.32*axis);
        distance = min(distance,length(p-bud)-r*.61);
        float3 curl = lobe+r*(.58*axis-.64*radial);
        distance = min(distance,length(p-curl)-r*.49);
        float3 tangent = cross(axis,radial);
        float3 fold = bud+r*(.40*tangent+.26*radial);
        distance = min(distance,length(p-fold)-r*.35);
    }
    return distance;
}

float4 plumeField(float3 p)
{
    float3 n = p*_BankScale;
    float3 bend = float3(noise3(n*1.3+4),noise3(n*1.3+27),noise3(n*1.3+58))-.5;
    float3 w = p+.053*bend;
    float grain = .58*noise3(n*4.1+2*bend)+.29*noise3(n*9.3+13)+.13*noise3(n*18.7+57)-.5;
    float d = plumeDistance(w,float3(-.29,-.22,.13),float3(-.06,.11,.22)+.14*_FormShift,
                               float3(.018,.043,-.018),.079,.7);
    d = min(d,plumeDistance(w,float3(.26,.31,.32),float3(.09,.055,.26)-.13*_FormShift.yzx,
                               float3(.038,-.012,-.033),.083,3.1));
    d = min(d,plumeDistance(w,float3(.24,-.23,.17),float3(.11,-.08,.085)+.11*_FormShift.zxy,
                               float3(-.026,.032,-.024),.064,1.8));
    d += (.026+.032*_Wisps)*grain + (.55-_Coverage)*.083;
    float margin = max(.006,_EdgeSoftness);
    float density = (1-smoothstep(-margin,margin,d))*(.62+.65*_CloudBody);
    float envelope = exp2(-max(0,d)*max(0,d)*530);
    float veil = envelope*(.010+.012*grain);
    return float4(density+veil,veil+.14*envelope*(1-density*.65),0,0);
}

float shoulderDisplacement(float3 p)
{
    float3 uv = p*(_BankScale*.47)+float3(.37,.59,.19);
    float mainLobes = _ShapeTexture.SampleLevel(sampler_linear_repeat,uv,0);
    float smallerLobes = _ShapeTexture.SampleLevel(sampler_linear_repeat,uv.yzx*2.16+.41,0);
    return _ShapeDisplacement*(2*(.77*mainLobes+.23*smallerLobes)-1);
}

// A near bank and a lower shelf overlap a separate, folded gas curtain.
// All distances are volume-local, so a camera can pass between the layers.
float4 backlitBank(float3 p)
{
    float3 n = p*_BankScale + 1.7*_FormShift;
    float3 warp = float3(noise3(n*1.3+5),noise3(n*1.3+19),noise3(n*1.3+45))-.5;
    n += 1.55*warp;
    float grain = .54*noise3(n*2.4)+.27*noise3(n*5.2+9)+.13*noise3(n*11.1+21)+.06*noise3(n*23.4+41)-.5;
    float3 w = p+.105*warp;
    // Turbulence pulled sideways along a front survives integration through its depth.
    float3 front = float3(p.xy,p.z*.29)*_BankScale+1.7*_FormShift;
    float3 twist = float3(noise3(front*2.3+7),noise3(front*2.3+32),noise3(front*2.3+55))-.5;
    front += 1.48*twist;
    float torn = .55*noise3(front*4.3)+.26*noise3(front*9.7+12)+.13*noise3(front*20+33)
               +.06*noise3(front*37+29)-.5;
    float hook = .041*exp2(-pow(abs(w.y-.070)/.021,2)) + .039*smoothstep(.08,.18,w.y);
    float edge = w.x-.043-.43*w.y + .034*cos(14*w.y+.3) + hook + .13*grain + .15*_Wisps*torn;
    float depth = w.z-.035-.33*w.x+.16*w.y;
    float body = edge - 5.6*depth*depth + .095*(_Coverage-.55);
    float shelf = -.122-w.y+.048*cos(15*w.x+.5)+.18*w.x+.13*grain+.10*_Wisps*torn;
    shelf -= 7.6*pow(abs(w.z+.003+.28*w.x),2);
    // A single volume-local displacement connects the near lip, bank and rear shoulders.
    float displacement = 0;
    if (_LayeredCurtain && _ShapeDisplacement>0)
        displacement = shoulderDisplacement(p);
    float bank = max(body,shelf);
    bank += .70*displacement;
    float dust = smoothstep(-.009,.037,bank)*(.85+1.8*_CloudBody+1.45*grain);
    float skin = exp2(-pow(abs(bank+.009)/.009,2))*smoothstep(-.19,.15,torn+.08);
    float fringe = exp2(-pow(abs(bank+.029+.028*grain)/.006,2))*smoothstep(-.03,.23,grain-torn);

    // A broad, tilted bank crosses the opening behind the near silhouette.
    // Its top and underside fold independently of the near bank's noise.
    float3 middleUV = float3(p.x+.14*p.z,p.y,p.z*.46-.21*p.y)*_BankScale;
    middleUV += .82*warp.yzx+3.8+_FormShift;
    float rolling = noise3(middleUV*2.6)-.5;
    float scallops = .66*noise3(middleUV*5.8+.9*rolling)+.34*noise3(middleUV*12.2+17)-.5;
    float crest = .042-.20*p.x+.062*sin(17*p.x+.16)+.108*rolling+.065*_Wisps*scallops;
    float below = crest-p.y;
    float crossDepth = p.z-.135+.29*p.x-.36*p.y-.11*rolling;
    float span = exp2(-pow(abs(crossDepth)/.037,2));
    float underside = .045+.026*sin(18*p.x)+.060*rolling;
    float middle = span*smoothstep(-.012,.013,below)*(1-smoothstep(underside,underside+.035,below));
    float crestLight = span*exp2(-pow(abs(below+.006)/.012,2))*(.48+1.65*smoothstep(-.18,.21,scallops));

    // A nearer ragged lip curls across the front of the dark wall. Its thin
    // edge catches diffuse starlight over the otherwise shaded face.
    float lipDepth = p.z+.216+.22*p.x-.055*rolling;
    float lipSpan = exp2(-pow(abs(lipDepth)/.041,2));
    float lipHeight = -.046+.53*p.x+.023*sin(19*p.x-1)+.078*grain+.036*torn;
    float lipEdge = p.y-lipHeight-.45*displacement;
    float nearLip = lipSpan*(1-smoothstep(-.021,.013,lipEdge))*smoothstep(-.14,-.04,p.x);
    float lipRim = lipSpan*exp2(-pow(abs(lipEdge)/.014,2))*smoothstep(-.14,-.04,p.x);

    float curtain = w.z-.313-.33*w.x+.18*w.y-.073*sin(12*w.y+5*w.x)-.16*grain;
    // Concentrate the emission on folded surfaces. Thick, evenly luminous
    // gas averages their different depths into a soft patch along a camera ray.
    float mist = exp2(-pow(abs(curtain)/.037,2));
    // Two overlapping folds share a broad gas body. Break up the edges by
    // displacing their contours, rather than varying brightness cell by cell.
    float3 pleat = float3(p.x+.055*p.z,p.y-.044*p.z,.24*p.z)*_BankScale+_FormShift;
    float3 turn = float3(noise3(pleat*1.5+31),noise3(pleat*1.5+67),noise3(pleat*1.5+18))-.5;
    pleat += 1.78*turn;
    float curl = noise3(pleat*3.0+8)-.5;
    float tips = noise3(pleat*7.5+15+1.2*curl)-.5;
    float contour = p.y-.083-.32*p.x-.068*sin(11*p.x+.53)-.09*(p.z-.30);
    contour += .16*turn.y + .13*curl + _Wisps*.034*tips;
    float shoulder = exp2(-pow(abs(contour+.020)/.038,2));
    float lip = exp2(-pow(abs(contour)/.009,2))*smoothstep(-.32,.16,curl+.29*warp.x);
    float returnFold = curtain+.050+.065*warp.z;
    float backContour = contour-.095+.074*sin(8*w.x-1.1)-.10*curl;
    float returnLip = exp2(-pow(abs(returnFold)/.026,2))*exp2(-pow(abs(backContour)/.023,2));
    float pocket = exp2(-dot((w.xy-float2(-.08,.11))/float2(.29,.22),
                              (w.xy-float2(-.08,.11))/float2(.29,.22)));
    float curtainGas = mist*(.58+1.15*smoothstep(-.20,.26,grain)+1.6*shoulder+2.2*lip) + 2.6*returnLip;
    float gas = pocket*curtainGas + 3.8*skin + 2.0*fringe + 1.55*crestLight + .09*middle;
    if (_LayeredCurtain)
    {
        // Give each shelf a curved cross-section. Rays grazing its crest
        // see an illuminated lip; rays below it pass through absorbing dust.
        float nearZ = p.z-.205+.19*p.x-.10*turn.x;
        float farZ = p.z-.347-.16*p.x+.07*turn.y;
        float nearCrest = .131+.40*max(w.x,-.11)+.040*sin(13*w.x+.65)-w.y;
        float farCrest = .226+.27*max(w.x,-.17)+.058*sin(9*w.x-1.1)-w.y;
        nearCrest += .086*curl+.072*_Wisps*torn;
        farCrest += .13*turn.x-.062*curl+.049*_Wisps*tips;
        float frontFold = nearCrest-16*nearZ*nearZ;
        float rearFold = farCrest-19*farZ*farZ;
        // Close each shelf underneath, with different thicknesses along its span.
        frontFold = min(frontFold,.038+.036*turn.y-.84*nearCrest-9*nearZ*nearZ);
        rearFold = min(rearFold,.064+.048*curl-.81*farCrest-10*farZ*farZ);
        float taper = max(0,p.x-.077);
        float upper = max(frontFold,rearFold)-4*taper*taper;
        if (_ShapeDisplacement>0)
        {
            // Rounded banks follow the shelves' sweep but extend into the
            // curtain. Their overlapping cross-sections create a shaded recess.
            float3 frontMass = float3((w.x+.095)/.32,(nearCrest-.035)/.076,nearZ/.109);
            float3 rearMass = float3((w.x+.064)/.35,(farCrest-.042)/.091,farZ/.122);
            float rounded = max(.105*(1-length(frontMass)),.118*(1-length(rearMass)))-4*taper*taper;
            float rounding = saturate(_ShapeDisplacement/.045);
            upper = lerp(upper,rounded,.36*rounding)+displacement+.20*_ShapeDisplacement;
        }
        float extent = pocket;
        float core = smoothstep(-.006,.019,upper);
        float edgeLight = exp2(-pow(abs(upper+.006)/.011,2));
        float skirt = exp2(-pow(abs(upper+.024+.016*curl)/.009,2));
        // Keep the thickened shoulders translucent enough for the embedded star
        // to light their interior folds as well as the crest.
        dust += lerp(1.03,.68,saturate(_ShapeDisplacement/.045))*extent*core;
        // Let the common fine ridge sampler resolve these edges exactly as it
        // does the foreground shelf. The underside and curvature close the form.
        bank = max(bank,upper);
        float litSkin = 1.09*edgeLight+.52*skirt;
        gas += extent*(litSkin*lerp(1,.88,saturate(_ShapeDisplacement/.045))+.12*core-.54*curtainGas);
    }
    float shading = saturate(.52+1.7*torn+.7*grain)*(1-saturate(nearLip*3)) + lipRim*(1.3+1.6*scallops);
    return float4(dust+.095*mist*pocket+middle*(1.65+.82*scallops)+1.08*nearLip,gas,shading,bank);
}

float4 sculptedBank(float3 volumePoint)
{
    float3 p = volumePoint;
    if (_VaryBankLayout)
    {
        p = mul(_FrontBank,float4(volumePoint,1)).xyz;
        p.x += _BankBend.x*(1-cos(9*(p.y+.04)));
    }
    float3 near = p-float3(.26,-.085,.012);
    near.x -= .35*near.y;
    near.z += .22*near.y;
    float front = (length(near/float3(.245,.36,.153))-1)*.19;
    float3 spur = p-float3(.095,.003,.018);
    spur.x -= .50*spur.y;
    float tip = (length(spur/float3(.118,.17,.107))-1)*.12;
    float blend = saturate(.5+.5*(tip-front)/.055);
    front = lerp(tip,front,blend)-.055*blend*(1-blend);
    p = volumePoint;
    if (_VaryBankLayout)
        p = mul(_RearBank,float4(volumePoint,1)).xyz;
    if (_VaryBankLayout)
        p.y += _BankBend.y*sin(11*(p.x+.075));
    float3 far = p-float3(-.11,.135,.255);
    far.y -= .38*far.x+.058*sin(9*far.x+.4);
    float rear = (length(far/float3(.365,.145,.111))-1)*.14;
    // The back bank turns down into the opening behind the foreground spur.
    float3 ledge = p-float3(-.016,.008,.247);
    ledge.y += .30*ledge.x;
    float shoulder = (length(ledge/float3(.183,.088,.091))-1)*.105;
    float join = saturate(.5+.5*(shoulder-rear)/.045);
    rear = lerp(shoulder,rear,join)-.045*join*(1-join);
    float displacement = shoulderDisplacement(volumePoint);
    if (_RearCrease>0)
    {
        // A continuous raised lip and recessed underside cross the rear bank.
        // The fold leans through the volume and feathers out at both ends.
        float run = p.x+.115;
        float height = .105+.43*run+.016*sin(21*run-.25)+.22*(p.z-.19);
        float across = p.y-height+.009*(noise3(p*19+24)-.5);
        float span = smoothstep(-.188,-.134,p.x)*(1-smoothstep(.014,.083,p.x));
        // Follow the bend in depth as it passes from one shoulder to the next.
        float faceZ = .163-.044*exp2(-pow(abs(run)/.048,2))+.011*smoothstep(-.09,-.025,p.x);
        float2 roll = float2((across-.020)/.026,(p.z-faceZ)/.033);
        float2 recess = float2((across+.005)/.014,(p.z-faceZ+.012)/.047);
        float lip = .029*(length(roll)-1);
        float pocket = .022*(length(recess)-1);
        float existing = rear-displacement;
        float blendLip = saturate(.5+.5*(lip-existing)/.021);
        float folded = lerp(lip,existing,blendLip)-.021*blendLip*(1-blendLip);
        folded = max(folded,-pocket);
        float depth = 1-smoothstep(.039,.081,abs(p.z-faceZ));
        float bank = 1-smoothstep(.012,.044,existing);
        rear += _RearCrease*span*depth*bank*(folded-existing);
    }
    float distance = min(front,rear);
    if (_ForegroundShelf)
    {
        p = volumePoint;
        if (_VaryBankLayout)
        {
            p = mul(_ShelfBank,float4(volumePoint,1)).xyz;
            p.y += _BankBend.z*(1-cos(13*(p.x+.15)));
        }
        float3 shelf = p-float3(-.186,-.168,-.087);
        shelf.y -= .34*shelf.x+.013*sin(18*shelf.x);
        shelf.z += .20*shelf.x;
        float lower = (length(shelf/float3(.195,.048,.069))-1)*.067;
        distance = min(distance,lower);
    }
    distance -= displacement + .065*(_Coverage-.6);
    float margin = max(.006,_EdgeSoftness);
    float body = 1-smoothstep(-margin,margin,distance);
    return float4(body*(.45+.95*_CloudBody),.10*body,1,distance);
}

float4 sweptArc(float3 p)
{
    // The inner wall of an inclined, open shell. Its nearest edge passes
    // below the observer and the right arm recedes around the bright cavity.
    float3 uv = p*_BankScale+_FormShift;
    float3 turn = float3(noise3(uv*1.4+11),noise3(uv*1.4+31),noise3(uv*1.4+47))-.5;
    float3 curls = uv*2.2+1.65*turn;
    float ripple = noise3(curls)-.5;
    float grain = noise3(curls*2.9+.8*ripple+17)-.5;
    float3 sweep=p, shoulder=p, curl=p, canopyPoint=p;
    float3 shape=0;
    if (_VaryBankLayout)
    {
        sweep=mul(_ArcSweep,float4(p,1)).xyz;
        shoulder=mul(_ArcShoulder,float4(p,1)).xyz;
        curl=mul(_ArcHook,float4(p,1)).xyz;
        canopyPoint=mul(_ArcCanopy,float4(p,1)).xyz;
        shape=_ArcShape;
        // Let the shoulder bow and the hook lean while retaining their own local thickness.
        shoulder.x+=shape.y*(.60*shoulder.y+1.35*shoulder.y*shoulder.y);
        curl.x+=shape.z*(.40*curl.y+1.8*curl.y*curl.y);
    }
    float2 xy = sweep.xy-float2(-.038,.063);
    xy.y += .18*xy.x;
    float2 ellipse = xy/float2(.262,.206);
    float radius = max(.001,length(ellipse));
    float2 direction = ellipse/radius;
    float arc = (radius-1)*.186+.075*turn.x+.086*ripple+.028*grain;
    arc += .011*sin(4*direction.x+2*direction.y)+.07*(_Coverage-.6);
    float zSpine = -.045+.116*direction.x+.046*direction.x*direction.y+.048*turn.z;
    float z = sweep.z-zSpine;
    float crest = arc-8.1*z*z;
    // A second turn of the bank is visible through gaps in the first lip.
    float backZ = z-.135;
    float returnCrest = arc+.010+.048*direction.x-.043*ripple-10.8*backZ*backZ;
    float sectorEnd = .19*(.54-direction.y-.32*direction.x-.22*turn.y)+.12*shape.x;
    float edge = min(max(crest,returnCrest),sectorEnd);
    float nearZ = z+.120+.035*direction.x;
    float nearCrest = arc-.055+.042*sin(8*direction.x+1.2)+.044*grain-14*nearZ*nearZ;
    edge = max(edge,min(nearCrest,sectorEnd-.035));
    // A closer shoulder rises out of the lower sweep across the right-hand
    // wall. The far cool curl can still be seen above this warm rim.
    float outerX = .163+.56*shoulder.y+.022*sin(17*shoulder.y+.4)+.049*turn.x+.041*ripple+.015*grain;
    float outerZ = shoulder.z+.083-.34*shoulder.y+.019*turn.z;
    float rightArm = shoulder.x-outerX-13*outerZ*outerZ;
    rightArm = min(rightArm,.21-shoulder.y+.036*ripple);
    edge = max(edge,rightArm);
    // A rolled end of the far bank turns back into the opening. Its upper
    // end tapers to a point and the base overlaps the closer, warmer sweep.
    float t = saturate((curl.y+.128)/.287);
    float hookX = .188-.070*t-.064*t*t*t+.023*sin(8*t)+.034*turn.y;
    float hookZ = .130+.066*t+.026*turn.z;
    float2 hookSection = float2((curl.x-hookX)/lerp(.080,.009,t*t),(curl.z-hookZ)/lerp(.069,.014,t*t));
    float hook = (1-length(hookSection))*.061+.042*ripple+.019*grain;
    hook = min(hook,min(curl.y+.155,.168-curl.y));
    float3 canopy = canopyPoint-float3(-.210,.244,.097);
    canopy.y -= .48*canopy.x+.018*sin(17*canopy.x);
    float ceiling = (1-length(canopy/float3(.24,.067,.087)))*.075+.043*ripple+.014*grain;
    float coolBank = max(ceiling,hook);
    float warm = smoothstep(-.015,.021,edge-coolBank);
    // Thin gas behind the open centre catches the same star independently
    // of the dense swept bank. Its depth gives the camera room to pass.
    float3 core = (p-float3(-.026,.032,.245)+float3(.023*turn.y,.028*ripple,0))/float3(.205,.186,.109);
    float haze = exp2(-dot(core,core)*1.3)*(.43+.52*ripple+.24*turn.y);
    float veil = p.z-.216-.43*p.x+.21*p.y+.066*ripple+.047*turn.z;
    haze *= .44+1.45*exp2(-veil*veil*690);
    float3 pocket = (p-float3(-.022,-.004,.212)+.018*turn)/float3(.109,.055,.074);
    float3 stream = float3(p.x-.33*p.y+.13*p.z,p.y+.8*p.x*p.x,.24*p.z)*_BankScale;
    stream += float3(noise3(stream+16),noise3(stream+42),noise3(stream+7))*1.52;
    float filament = noise3(stream*3.2)+.30*noise3(stream*8.3+13);
    haze += .69*exp2(-dot(pocket,pocket))*(.63+.67*ripple);
    haze *= .74+.48*smoothstep(.35,.86,filament);
    return float4(.76+1.65*_CloudBody+.74*ripple,haze,warm,max(edge,coolBank));
}

[numthreads(4,4,4)]
void BuildDensity(uint3 id : SV_DispatchThreadID)
{
    float3 q = (id+.5)/_Resolution;
    float3 p = q-.5;
    // Keep the canonical composition at zero shift, including its box fade
    // and authored clearing. A variation shears and offsets only the medium.
    p = shiftedFormPosition(p);
    if (_StructureWarp != 0) p = warpStructure(p);
    float4 medium;
    if (_NebulaShape==NEBULA_SWEPT_ARC) medium = sweptArc(p);
    else if (_NebulaShape==NEBULA_SCULPTED_BANK) medium = sculptedBank(p);
    else if (_NebulaShape==NEBULA_BACKLIT_BANK) medium = backlitBank(p);
    else if (_NebulaShape==NEBULA_PLUMES) medium = plumeField(p);
    else if (_NebulaShape==NEBULA_PAINTERLY) medium = emissionCavity(p);
    else medium = cloudAndLanes(p);
    if (_DomainPattern != 0)
    {
        _MediumOutput[id] = medium;
        return;
    }
    float3 edge = min(q,1-q);
    float boundary = smoothstep(0,.075,min(edge.x,min(edge.y,edge.z)));
    float cavity = _Clearing.w > 0 ? smoothstep(_Clearing.w,_Clearing.w+_ClearingSoftness,length(q-_Clearing.xyz)) : 1;
    if (_NebulaShape==NEBULA_SCULPTED_BANK) medium.z = boundary*cavity;
    _MediumOutput[id] = float4(medium.xy*boundary*cavity,medium.zw);
}

// Store integrated density per box width. Extinction and light color can then change without a rebuild.
[numthreads(4,4,4)]
void StarOpticalDepth(uint3 id : SV_DispatchThreadID)
{
    float3 q = (id+.5)/_Resolution;
    float3 delta = _StarUVW-q;
    float dist = max(length(delta),1e-6);
    float3 dir = delta/dist;
    float3 toEdge = lerp(q,1-q,step(0,dir))/max(abs(dir),1e-7);
    float reach = min(dist,min(toEdge.x,min(toEdge.y,toEdge.z)));
    int count = 32;
    bool detailed = usesSurfaceDetail();
    if (detailed) count += (int)round(32*_SurfaceDetail);
    if (_NebulaShape==NEBULA_SCULPTED_BANK) count += (int)round(32*_SurfaceDetail*_FoldRelief);
    if (_DomainPattern!=0) count = max(count,64);
    float stride = reach/count;
    float sum = 0;
    for(int i=0;i<count;i++)
        sum += sampleMedium(q+dir*((i+.5)*stride),detailed ? dir*stride : 0).x;
    _Output[id] = sum*stride;
}
