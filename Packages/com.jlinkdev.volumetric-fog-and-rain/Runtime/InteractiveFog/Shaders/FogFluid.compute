Texture3D<float4> _Velocity, _VelocityPredictRead, _CoordinatesA, _CoordinatesB;
RWTexture3D<float4> _VelocityPredicted, _CoordinatesAOut, _CoordinatesBOut;
RWTexture3D<float4> _VelocityOut, _Curl;
Texture3D<float> _Density, _Pressure, _PredictRead;
Texture3D<float4> _CumulusShape;
Texture3D<float> _CumulusRestProxy;
RWTexture3D<float> _DensityOut, _PressureOut, _Divergence, _Solid, _Predicted;
RWTexture3D<float> _RestDensity;
RWTexture3D<float4> _CumulusShapeOut;
int3 _CumulusDetailResolution;
RWTexture2D<float2> _FoldPatternOut;
Texture2D<float2> _FoldPattern;
SamplerState sampler_linear_repeat;
RWTexture3D<float4> _Lighting;
SamplerState sampler_linear_clamp;
int3 _Resolution;
float3 _Size, _Origin, _Cell, _Wind, _LightDirection;
float4 _Fluid, _Turbulence, _Cumulus;
int2 _ResetCoordinates;
float _Dt, _Extinction, _SimTime, _RestRecovery, _CloudCoverage, _GroundPatchiness;
int _ObstacleCount, _SourceCount;
int _ReferenceWork;
int _LocalLightCount;
float4 _LocalLightPositions[8], _LocalLightColors[8];
float4x4 _Obstacles[16];
float4 _Sources[16], _Previous[16], _Velocities[16], _Shapes[16];

float hash(float3 p) { p = frac(p * .1031); p += dot(p, p.yzx + 33.33); return frac((p.x + p.y) * p.z); }
float noise(float3 p)
{
    float3 i = floor(p), f = frac(p); f = f*f*(3-2*f);
    return lerp(lerp(lerp(hash(i), hash(i+float3(1,0,0)),f.x), lerp(hash(i+float3(0,1,0)),hash(i+float3(1,1,0)),f.x),f.y),
        lerp(lerp(hash(i+float3(0,0,1)),hash(i+float3(1,0,1)),f.x),lerp(hash(i+float3(0,1,1)),hash(i+1),f.x),f.y),f.z);
}
float3 curlPattern(float3 p)
{
    // Analytic curl of A=(sin(y)sin(z), sin(z)sin(x), sin(x)sin(y)).
    float3 s=sin(p), c=cos(p);
    return float3(s.x*(c.y-c.z),s.y*(c.z-c.x),s.z*(c.x-c.y));
}
#include "FogPuffs.hlsl"
#include "FogProceduralPuffs.hlsl"

float3 cumulusFlow(float3 p)
{
    float3 q=(p-_Origin)*3.2/max(.5,_Cumulus.y)+float3(_SimTime*.11,0,_SimTime*.07);
    float3 flow=curlPattern(q+float3(2.1,5.4,8.7))*_Cumulus.z*.25;
    flow.y*=1-smoothstep(_Fluid.z*.5,_Fluid.z*.95,p.y-_Origin.y);
    return flow;
}
float2 broadFlow(float2 p)
{
    float2 q=p*.85+float2(.7,1.3);
    // Horizontal curl of a broad stream function; paired recirculation, not radial clearing.
    return float2(sin(q.x)*cos(q.y),-cos(q.x)*sin(q.y));
}
[numthreads(8,8,1)] void BuildFoldPattern(uint3 id : SV_DispatchThreadID)
{
    if(any(id.xy>=512)) return;
    float2 p=(id.xy+.5)/512.0*16;
    float2 cell=floor(p/4), displacement=0;
    // Sparse local turns, with jittered centres, unequal radii and both handednesses.
    // Compact support leaves broad uncurled banks between them; no global stripe carrier.
    [unroll] for(int y=-1;y<=1;y++) [unroll] for(int x=-1;x<=1;x++)
    {
        float2 c=cell+float2(x,y), key=c-floor(c/4)*4;
        float seed=hash(float3(key,7.3));
        float2 jitter=float2(hash(float3(key,13.1)),hash(float3(key,29.7)));
        float2 delta=p-(c+.15+jitter*.7)*4;
        float radius=1.1+hash(float3(key,41.2))*1.1;
        float weight=saturate(1-dot(delta,delta)/(radius*radius));
        float angle=(seed<.5?-1:1)*(2.1+seed*1.7)*weight*weight*step(.22,seed);
        float s,cosa; sincos(angle,s,cosa);
        displacement+=float2(cosa*delta.x-s*delta.y,s*delta.x+cosa*delta.y)-delta;
    }
    // Cache a coordinate deformation, not a density/stripe texture. The original
    // volumetric billow noise supplies the body inside and outside each local curl.
    _FoldPatternOut[id.xy]=displacement*.5;
}
float fbm(float3 p) { return noise(p)*.57 + noise(p*2.07+11.4)*.28 + noise(p*4.13+27.6)*.15; }
bool invalid(uint3 p) { return any(p >= (uint3)_Resolution); }
int3 clampCell(int3 p) { return clamp(p, 0, _Resolution-1); }
float3 uv(int3 p) { return (p+.5)/(float3)_Resolution; }
float3 world(int3 p) { return _Origin + uv(p)*_Size; }
bool blocked(int3 p) { return any(p<0) || any(p>=_Resolution) || _Solid[clampCell(p)]>.5; }
float3 vel(int3 p) { return blocked(p) ? 0 : _Velocity.Load(int4(clampCell(p),0)).xyz; }
float pressure(int3 p, int3 center) { return _Pressure.Load(int4(blocked(p) ? center : p,0)); }
float3 boundVelocity(int3 p, float3 v)
{
    if (blocked(p)) return 0;
    if (blocked(p+int3(1,0,0)) || blocked(p-int3(1,0,0))) v.x=0;
    if (blocked(p+int3(0,1,0)) || blocked(p-int3(0,1,0))) v.y=0;
    if (blocked(p+int3(0,0,1)) || blocked(p-int3(0,0,1))) v.z=0;
    return clamp(v,-8,8);
}
float solidAt(float3 p)
{
    for (int i=0;i<_ObstacleCount;i++) if (all(abs(mul(_Obstacles[i],float4(p,1)).xyz)<.5)) return 1;
    return 0;
}
// Cached only on initialization/style-shape changes; never evaluated per ray step.
float cloudCells(float3 p)
{
    float3 cell=floor(p), f=frac(p); float closest=4;
    [loop] for(int z=-1;z<=1;z++) [loop] for(int y=-1;y<=1;y++) [loop] for(int x=-1;x<=1;x++)
    {
        float3 neighbor=float3(x,y,z), key=cell+neighbor;
        float3 featurePoint=float3(hash(key+3.7),hash(key+17.3),hash(key+41.9));
        float3 delta=neighbor+featurePoint-f;
        closest=min(closest,dot(delta,delta));
    }
    return saturate(1-sqrt(closest));
}
float4 cumulusDensities(float3 p)
{
    float scale=_Cumulus.y, height=_Fluid.z;
    float3 corePosition=p;
    float spacing=scale*1.6;
    float2 cell=floor(p.xz/spacing);
    float body=0, transport=0, envelope=0;
    float ribbonDistance=8;
    float2 ribbonCoordinates=64;
    float ribbonOpacity=0;
    // Bake a short curl advection into the authored shape. Repeated small turns
    // stretch the fringe into folds while keeping the overall cluster scale.
    [unroll] for(int fold=0;fold<4;fold++)
    {
        float3 flow=curlPattern(p/scale*3.3+float3(2.1,5.4,8.7));
        flow+=curlPattern(p.zxy/scale*7.3+float3(8.2,1.7,3.9)).yzx*.22;
        p-=flow*scale*.025;
    }
    [loop] for(int z=-1;z<=1;z++) [loop] for(int x=-1;x<=1;x++)
    {
        float2 key=cell+float2(x,z);
        float seed=hash(float3(key,12.7));
        float2 center=(key+.18+float2(hash(float3(key,3.2)),hash(float3(key,9.4)))*.64)*spacing;
        float angle=seed*6.283185;
        float2 dir=float2(cos(angle),sin(angle)), side=float2(-dir.y,dir.x);
        float2 delta=p.xz-center;
        float3 q=float3(dot(delta,dir),p.y,dot(delta,side));
        float radius=scale*lerp(.3,1.1,pow(seed,2.0));
        float vertical=min(height*.55,radius*(.8+.3*hash(float3(key,32.1))));
        // A local roll bends the attached cloudlets and their fringe together.
        float3 roll=q-float3(radius*.25,vertical*.85,0);
        float turn=(seed<.5?-1:1)*1.7*pow(saturate(1-length(roll.xy)/max(.1,radius*1.5)),2);
        float sn,cs; sincos(turn,sn,cs);
        q.xy=float2(cs*roll.x-sn*roll.y,sn*roll.x+cs*roll.y)+float2(radius*.25,vertical*.85);
        float3 c=float3(0,vertical*.72,0);
        float2 coreDelta=corePosition.xz-center;
        float3 coreQ=float3(dot(coreDelta,dir),corePosition.y,dot(coreDelta,side));
        float distance=length((coreQ-c)/float3(radius,vertical,radius*.96));
        // Unequal round bodies with sharper cores and smaller attached cloudlets.
        distance+=(fbm(coreQ/scale*2.4+float3(4.2,1.3,7.1))-.5)*.13*smoothstep(.35,1,distance);
        float core=1-smoothstep(.62,1.06,distance);
        float d=core*(.8+.2*sqrt(seed));
        float proxy=core;
        int budCount=2+(int)(hash(float3(key,66.3))*4);
        [unroll] for(int j=0;j<5;j++)
        {
            if(j>=budCount) continue;
            float r=hash(float3(key,j*13.7+27));
            float a=hash(float3(key,j*8.3+39))*6.283185;
            float satellite=radius*(.28+.3*r);
            float elevation=lerp(.15,1.2,hash(float3(key,j*19.1+51)));
            float3 c2=c+float3(cos(a)*radius*cos(elevation),vertical*sin(elevation),sin(a)*radius*cos(elevation))*.8;
            // Rounded, overlapping lobes retain their volume; only their fringes roll.
            float3 budPosition=lerp(coreQ,q,.18);
            float small=length((budPosition-c2)/float3(satellite,satellite*.96,satellite));
            d=max(d,(1-smoothstep(.65,1.06,small))*(.7+.3*r));
            proxy=max(proxy,1-smoothstep(.6,1.1,small));
        }
        body=max(body,d);
        transport=max(transport,proxy);
        if(seed>.2) [unroll] for(int ribbon=0;ribbon<2;ribbon++)
        {
            // A continuous tapered spiral ribbon, independent of the cloud body's texture.
            // The cross-section is thin in its curling plane and broad in depth.
            float handed=seed<.6?-1:1;
            float3 rq=ribbon==0?q:float3(-q.z,q.y,q.x);
            float ribbonHeight=min(height*.86,vertical*(1.65+.3*seed));
            float curlSize=min(min(height*.31,radius*.65),max(.12,height-ribbonHeight+.04))*(ribbon==0?1:.65);
            float2 v=float2(rq.x*handed-radius*(ribbon==0?.55:.35),rq.y-ribbonHeight);
            float theta=atan2(v.y,v.x);
            if(theta<-2.2) theta+=6.283185;
            float t=saturate((theta+2.2)/(3.4+seed*.9));
            float spiralRadius=curlSize*lerp(1,.34,t)*(1+.12*sin(theta*2+seed*9));
            float width=max(.006,scale*.028);
            float sheet=1-smoothstep(curlSize*.18,curlSize*lerp(.8,.3,t),abs(rq.z));
            float taper=smoothstep(0,.12,t)*(1-smoothstep(.8,1,t));
            float opacity=sheet*taper*lerp(.9,.3,t);
            // Measure a tapered elliptical filament in its curling plane and depth.
            // The cache stores the unsigned distance to avoid false zero crossings.
            float sheetDistance=length(v)-spiralRadius;
            float selection=length(float2(sheetDistance,rq.z))+(1-taper)*curlSize*.5;
            if(selection<ribbonDistance)
            {
                ribbonDistance=selection;
                float thinWidth=width*max(.04,taper)*lerp(1,.5,t);
                ribbonCoordinates=clamp(float2(sheetDistance/thinWidth,rq.z/(thinWidth*4)),-64,64);
                ribbonOpacity=lerp(1,.5,t);
            }
            float broadArc=1-smoothstep(width*.15,max(width,.11),abs(sheetDistance));
            float support=(1-smoothstep(.6,1.4,length(v)/max(.04,curlSize)))*sheet*.35;
            envelope=max(envelope,max(broadArc*opacity,support));
        }
    }
    // Cellular erosion makes rounded cloudlets instead of fibrous contour stripes.
    // Large cores survive; progressively finer detail only removes their thin outer fringe.
    float3 detailP=p/scale+curlPattern(p/scale*1.2)*.12;
    float cells=cloudCells(detailP*1.9), fineCells=cloudCells(detailP*5.3);
    // Value erosion preserves the filled core rather than multiplying holes through it.
    float erosion=(1-cells)*.17;
    float coarseBody=saturate((body-erosion)/(1-erosion));
    float fineErosion=(1-fineCells)*.1;
    float fineBody=pow(saturate((coarseBody-fineErosion)/(1-fineErosion)),.6);
    fineBody*=.8+.2*noise(detailP*4.5+curlPattern(detailP*2)*1.8);
    float skirtTop=height*(.15+.4*fbm(float3(p.x/scale,3.7,p.z/scale)));
    float skirt=(1-smoothstep(0,skirtTop,p.y))*(.2+.2*noise(p/scale*1.6));
    // Coverage fills between the large banks with smaller round billows, not a flat slab.
    // Jitter, unequal radii and omitted cells leave irregular windows through the clouds.
    float infill=0;
    if(_CloudCoverage>0)
    {
        float smallSpacing=scale*.95;
        float2 smallCell=floor(corePosition.xz/smallSpacing);
        [loop] for(int sz=-1;sz<=1;sz++) [loop] for(int sx=-1;sx<=1;sx++)
        {
            float2 key=smallCell+float2(sx,sz);
            float seed=hash(float3(key,101.7));
            if(seed<.12) continue;
            float2 center=(key+.15+float2(hash(float3(key,107.3)),hash(float3(key,113.9)))*.7)*smallSpacing;
            // A broad size distribution makes banks with small shoulders and larger crowns.
            float radius=scale*lerp(.36,1.06,pow(hash(float3(key,127.1)),.65));
            float vertical=min(height*lerp(.3,.51,seed),radius*lerp(.82,1.08,seed));
            float3 delta=corePosition-float3(center.x,vertical*lerp(.4,.75,seed),center.y);
            delta+=curlPattern(corePosition/scale*1.7+float3(7.1,2.9,11.3))*scale*.022;
            float sphere=length(delta/float3(radius,vertical,radius));
            float puff=1-smoothstep(.58,1.08,sphere);
            // Soft union lifts the saddle between overlapping lobes without a horizontal bed.
            float join=saturate(1-abs(infill-puff)/.24);
            infill=max(infill,puff)+join*join*.06*saturate(min(infill,puff)*8);
        }
    }
    infill*=saturate(_CloudCoverage);
    float infillBody=infill*(.88+.12*noise(detailP*4.5));
    fineBody=max(fineBody,infillBody)+min(fineBody,infillBody)*.16;
    transport=max(transport,infill)+min(transport,infill)*.16;
    float fade=1-smoothstep(height*.94,height*1.08,p.y);
    ribbonCoordinates=fade>.001?ribbonCoordinates/max(.1,fade):64;
    // Unsigned distance cannot invent a filament where neighboring nearest curves change.
    return float4(max(fineBody,skirt)*fade,max(transport,max(envelope,skirt))*fade,length(ribbonCoordinates),ribbonOpacity*fade);
}
float restingDensity(uint3 id)
{
    float3 p=world(id),local=uv(id)*_Size;
    float result=0;
    if(_Cumulus.x>.5 && _Cumulus.x<1.5)
        result=cumulusDensities(float3(p.x,local.y,p.z)).y;
    else if(_Cumulus.x>1.5)
    {
        float mistBank=smoothstep(.25,.75,noise(float3(p.x*.28,4.2,p.z*.28)));
        float2 mistTurn=_FoldPattern.SampleLevel(sampler_linear_repeat,local.xz/24,0)*1.6;
        float3 mistPosition=p+float3(mistTurn.x,0,mistTurn.y);
        float3 ridgePosition=mistPosition*float3(.65,.35,.95);
        ridgePosition+=curlPattern(ridgePosition*.8)*1.15;
        float ridge=pow(saturate(1-abs(noise(ridgePosition)-.5)*2.3),1.5);
        float shoulder=noise(ridgePosition*1.8+float3(7,3,9));
        float mistTop=_Fluid.z*(.4+(ridge+.4*shoulder)*(.65+.5*mistBank));
        result=(1-smoothstep(mistTop*.28,mistTop,local.y))*(.4+ridge*.8)*(.6+mistBank*.4);
    }
    else
    {
        float bank=fbm(float3(p.x*.34,4.2,p.z*.34));
        float2 turn=_FoldPattern.SampleLevel(sampler_linear_repeat,local.xz/(16*1.5),0);
        float3 shaped=p+float3(turn.x,0,turn.y)*1.5;
        float ribbon=noise(float3(shaped.x*.7,shaped.y*2,shaped.z*1.4)+curlPattern(shaped*.8)*1.2);
        float top=_Fluid.z*(.4+.25*bank+.65*ribbon);
        float densityScale=1;
        if (_GroundPatchiness > 0)
        {
            // Warped, elongated banks share the simulation's rest/recovery field and move with the fluid.
            float2 flow = shaped.xz + turn * 2.5;
            float3 bankCoordinates = float3(dot(flow, float2(.21, .12)), 0, dot(flow, float2(-.30, .66)));
            float channel = noise(bankCoordinates + float3(-1.5, 5.37, .25));
            float ridge = smoothstep(.31, .70, channel * .76 + ribbon * .24);
            densityScale = lerp(1, lerp(.025, 1.65, ridge * ridge), _GroundPatchiness);
            top *= lerp(1, lerp(.34, 1.28, ridge), _GroundPatchiness);
        }
        result=(1-smoothstep(top*.22,top,local.y))*(.68+.32*bank)*(.65+.7*ribbon);
        result *= densityScale;
    }
    return result;
}
[numthreads(8,4,8)] void BuildCumulusShape(uint3 id : SV_DispatchThreadID)
{
    if(any(id>=(uint3)_CumulusDetailResolution)) return;
    float3 local=(id+.5)/(float3)_CumulusDetailResolution*_Size;
    float4 shape=cumulusDensities(float3(local.x+_Origin.x,local.y,local.z+_Origin.z));
    // Normalize against the actual filtered transport field, not its analytic source.
    // Otherwise the coarse grid's boundary blur survives the high-resolution detail.
    shape.y=_CumulusRestProxy.SampleLevel(sampler_linear_clamp,local/_Size,0);
    _CumulusShapeOut[id]=shape;
}
[numthreads(8,4,8)] void BuildRestingDensity(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return;
    _RestDensity[id]=restingDensity(id);
}
[numthreads(8,4,8)] void Initialize(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return;
    float3 p=world(id), local=uv(id)*_Size;
    float d=restingDensity(id);
    // Store the unmasked resting layer so vacated obstacles can also recover.
    _RestDensity[id] = d;
    _Solid[id] = solidAt(p); d *= 1-_Solid[id];
    _DensityOut[id] = d;
    _CoordinatesAOut[id] = _CoordinatesBOut[id] = float4(local,0);
    float2 circulation=broadFlow(p.xz)*.18;
    float3 initialFlow=_Wind+float3(circulation.x,0,circulation.y);
    if(_Cumulus.x>.5 && _Cumulus.x<1.5) initialFlow+=cumulusFlow(p);
    _VelocityOut[id] = float4(initialFlow,0); _PressureOut[id]=0; _Lighting[id]=1;
}
[numthreads(8,4,8)] void BuildObstacles(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return; _Solid[id] = solidAt(world(id));
}
[numthreads(8,4,8)] void AdvectVelocity(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return;
    float3 v = vel(id), back = uv(id) - _Dt * v / _Size;
    // Stop a backtrace at a solid sample instead of transporting through a wall.
    int3 b = clampCell((int3)(back*_Resolution));
    float3 advected = _Solid[b]>.5 ? 0 : _Velocity.SampleLevel(sampler_linear_clamp,back,0).xyz;
    _VelocityPredicted[id]=float4(boundVelocity(id,advected),0);
}
[numthreads(8,4,8)] void CorrectVelocity(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return;
    float3 v=vel(id), back=uv(id)-v*_Dt/_Size;
    float3 reverse=_VelocityPredictRead.SampleLevel(sampler_linear_clamp,uv(id)+v*_Dt/_Size,0).xyz;
    float3 corrected=_VelocityPredictRead.Load(int4(id,0)).xyz+.5*(v-reverse);
    int3 b=floor(back*_Resolution-.5); float3 lo=100,hi=-100;
    for(int z=0;z<2;z++) for(int y=0;y<2;y++) for(int x=0;x<2;x++)
    { float3 value=vel(clampCell(b+int3(x,y,z))); lo=min(lo,value); hi=max(hi,value); }
    _VelocityOut[id]=float4(boundVelocity(id,clamp(corrected,lo,hi)*exp(-_Dt*_Fluid.y)),0);
}
float sourceWeight(float3 p, int i);
[numthreads(8,4,8)] void AdvectCoordinates(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return;
    float3 back=uv(id)-vel(id)*_Dt/_Size;
    // Staggered six-second resets bound distortion. The resetting map has zero render weight.
    bool resetA=_ResetCoordinates.x!=0;
    bool resetB=_ResetCoordinates.y!=0;
    _CoordinatesAOut[id]=resetA?float4(uv(id)*_Size,0):_CoordinatesA.SampleLevel(sampler_linear_clamp,back,0);
    _CoordinatesBOut[id]=resetB?float4(uv(id)*_Size,0):_CoordinatesB.SampleLevel(sampler_linear_clamp,back,0);
    float oldActivity=_CoordinatesA.SampleLevel(sampler_linear_clamp,back,0).w;
    // Carry a finite wake-energy marker instead of feeding turbulence back into itself.
    float activity=oldActivity*exp(-_Dt*.65);
    for(int i=0;i<_SourceCount;i++)
    {
        float speed=length(_Velocities[i].xyz);
        if(_Shapes[i].w<0 && speed<.01) speed=5; // AddGust's zero vector denotes a radial blast.
        // Supplemental wake stirring fades out with drag; explicit gusts remain independent.
        float coupling=_Shapes[i].w<0?1:saturate(_Shapes[i].z);
        activity=max(activity,sourceWeight(world(id),i)*saturate(speed*.5)*coupling);
    }
    activity=max(activity,puffActivity(world(id)));
    float4 a=_CoordinatesAOut[id],b=_CoordinatesBOut[id]; a.w=b.w=activity;
    _CoordinatesAOut[id]=a; _CoordinatesBOut[id]=b;
}
[numthreads(8,4,8)] void Curl(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return;
    int3 p=id;
    float3 dx=(vel(p+int3(1,0,0))-vel(p-int3(1,0,0)))/(2*_Cell.x);
    float3 dy=(vel(p+int3(0,1,0))-vel(p-int3(0,1,0)))/(2*_Cell.y);
    float3 dz=(vel(p+int3(0,0,1))-vel(p-int3(0,0,1)))/(2*_Cell.z);
    float3 c=float3(dy.z-dz.y,dz.x-dx.z,dx.y-dy.x); _Curl[id]=float4(c,length(c));
}
float sourceWeight(float3 p, int i)
{
    float3 a = _Previous[i].xyz, b = _Sources[i].xyz;
    p.y -= clamp(p.y-b.y, 0, _Shapes[i].y);
    float3 ab=b-a; float t=saturate(dot(p-a,ab)/max(dot(ab,ab),.0001));
    float distance = length(p-lerp(a,b,t));
    return 1-smoothstep(_Shapes[i].x*.25,_Shapes[i].x*2.4,distance);
}
[numthreads(8,4,8)] void Forces(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return;
    int3 p=id; float3 v=vel(p), pos=world(p);
    float3 eta=float3(_Curl[clampCell(p+int3(1,0,0))].w-_Curl[clampCell(p-int3(1,0,0))].w,
        _Curl[clampCell(p+int3(0,1,0))].w-_Curl[clampCell(p-int3(0,1,0))].w,
        _Curl[clampCell(p+int3(0,0,1))].w-_Curl[clampCell(p-int3(0,0,1))].w)/(2*_Cell);
    v += cross(eta/(length(eta)+.0001),_Curl[p].xyz)*_Fluid.x*_Dt*min(_Cell.x,min(_Cell.y,_Cell.z));
    float2 circulation=broadFlow(pos.xz)*.18;
    float3 ambientFlow=_Wind+float3(circulation.x,0,circulation.y);
    if(_Cumulus.x>.5 && _Cumulus.x<1.5) ambientFlow+=cumulusFlow(pos);
    v += (ambientFlow-v)*.12*_Dt;
    // Slow divergence-free circulation seeds visible curling before any interaction.
    float3 q=pos*1.1 + _SimTime*.1;
    v += float3(sin(q.z)*cos(q.y),sin(q.x)*cos(q.z)*.35,sin(q.y)*cos(q.x))*.06*_Dt;
    // Advected, multi-scale curl stirring follows existing wakes. Projection follows
    // modulation, which is not itself divergence-free near boundaries or varying activity.
    float blend=1-abs(frac(_SimTime/6)*2-1);
    float3 ca=_CoordinatesA.Load(int4(p,0)).xyz*6.283185/_Turbulence.y;
    float3 cb=_CoordinatesB.Load(int4(p,0)).xyz*6.283185/_Turbulence.y;
    float3 eddyA=curlPattern(ca+float3(2.7,7.1,4.3))+curlPattern(ca.zxy*1.91+float3(11.3,2.9,8.7)).yzx*.38;
    float3 eddyB=curlPattern(cb+float3(2.7,7.1,4.3))+curlPattern(cb.zxy*1.91+float3(11.3,2.9,8.7)).yzx*.38;
    float activity=.02+_CoordinatesA.Load(int4(p,0)).w*.85;
    v+=lerp(eddyB,eddyA,blend)*activity*_Turbulence.x*_Dt;
    if(_Cumulus.x>.5 && _Cumulus.x<1.5)
    {
        float h=uv(p).y*_Size.y/_Fluid.z;
        v.y+=_Cumulus.z*(.35+.65*sin(pos.x*1.7+pos.z*1.1+_SimTime*.3))*_Density.Load(int4(p,0))*_Dt;
        v.y-=max(0,h-.55)*_Cumulus.z*3*_Dt;
    }
    else v.y -= max(0, uv(p).y*_Size.y-_Fluid.z*.45)*_Density.Load(int4(p,0))*2.2*_Dt;
    // Once the wake marker fades, residual energetic motion must also settle;
    // otherwise it continually shreds the density ridges as they recover.
    float quiet=1-smoothstep(.02,.2,_CoordinatesA.Load(int4(p,0)).w);
    v=lerp(v,ambientFlow,1-exp(-_RestRecovery*2*quiet*_Dt));
    for(int i=0;i<_SourceCount;i++)
    {
        float w=sourceWeight(pos,i); float3 target=_Velocities[i].xyz;
        if(_Shapes[i].w>=0)
        {
            float speed=length(target.xz);
            float2 direction=target.xz/max(speed,.001), side=float2(-direction.y,direction.x);
            float radius=max(_Shapes[i].x*3.5,.3);
            float2 behind=_Sources[i].xz-direction*radius*.85;
            float vertical=1-smoothstep(_Shapes[i].y+radius*.3,_Shapes[i].y+radius*1.5,abs(pos.y-_Sources[i].y));
            // Counter-rotating vortices carry the displaced bank into the trailing wake.
            for(int sign=-1;sign<=1;sign+=2)
            {
                float2 offset=(pos.xz-behind-side*radius*.7*sign)/radius;
                v.xz+=float2(-offset.y,offset.x)*sign*exp(-dot(offset,offset))*speed*vertical*_Dt*2.7*saturate(_Shapes[i].z);
            }
            float2 outward=pos.xz-_Sources[i].xz; outward/=max(length(outward),.08);
            target.xz=target.xz*.65+outward*speed*.18;
            target.y+=speed*.08*w;
            // A stationary capsule does not damp the passing flow or erase a hole.
            w*=saturate(speed*2);
        }
        if(_Shapes[i].w<0 && length(target)<.01) target=normalize(pos-_Sources[i].xyz+float3(.001,.001,0))*5;
        v += (target-v)*w*(1-exp(-_Shapes[i].z*_Dt*4));
    }
    // Shallow ground fog retains horizontal rolls while lifted wisps settle quickly.
    v+=puffForce(pos)*_Dt;
    v.y*=exp(-_Dt*.35);
    _VelocityOut[id]=float4(boundVelocity(p,v),0);
}
[numthreads(8,4,8)] void Divergence(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return;
    int3 p=id;
    _Divergence[id] = blocked(p) ? 0 :
        (vel(p+int3(1,0,0)).x-vel(p-int3(1,0,0)).x)/(2*_Cell.x)+
        (vel(p+int3(0,1,0)).y-vel(p-int3(0,1,0)).y)/(2*_Cell.y)+
        (vel(p+int3(0,0,1)).z-vel(p-int3(0,0,1)).z)/(2*_Cell.z);
    _PressureOut[id]=0;
}
[numthreads(8,4,8)] void Pressure(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return;
    int3 p=id; float3 w=1/(_Cell*_Cell);
    float sum=(pressure(p+int3(1,0,0),p)+pressure(p-int3(1,0,0),p))*w.x+
        (pressure(p+int3(0,1,0),p)+pressure(p-int3(0,1,0),p))*w.y+
        (pressure(p+int3(0,0,1),p)+pressure(p-int3(0,0,1),p))*w.z;
    _PressureOut[id]=blocked(p)?0:(sum-_Divergence[p])/(2*(w.x+w.y+w.z));
}
[numthreads(8,4,8)] void Project(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return;
    int3 p=id;
    float3 gradient=float3(pressure(p+int3(1,0,0),p)-pressure(p-int3(1,0,0),p),
        pressure(p+int3(0,1,0),p)-pressure(p-int3(0,1,0),p),pressure(p+int3(0,0,1),p)-pressure(p-int3(0,0,1),p))/(2*_Cell);
    _VelocityOut[id]=float4(boundVelocity(p,vel(p)-gradient),0);
}
float densityAt(int3 p) { return blocked(p)?0:_Density.Load(int4(p,0)); }
float limitedSlope(int3 p,int3 axis)
{
    float center=densityAt(p);
    float left=center-densityAt(p-axis), right=densityAt(p+axis)-center;
    return left*right<=0?0:sign(left)*min(.5*abs(left+right),min(2*abs(left),2*abs(right)));
}
// A shared face flux is computed identically by both neighboring cells.
float faceFlux(int3 left,int3 axis,float spacing)
{
    int3 right=left+axis;
    if(blocked(left)||blocked(right)) return 0;
    float speed=dot((vel(left)+vel(right))*.5,(float3)axis);
    int3 donor=speed>=0?left:right;
    float slope=limitedSlope(donor,axis);
    float faceDensity=densityAt(donor)+sign(speed)*.5*slope*saturate(1-abs(speed)*_Dt/spacing);
    return speed*max(0,faceDensity)/spacing;
}
float cachedFlux(int3 p,int axis)
{
    if(any(p<0)||any(p>=_Resolution)) return 0;
    return _VelocityPredictRead.Load(int4(p,0))[axis];
}
[numthreads(8,4,8)] void BuildDensityFlux(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return;
    // Velocity advection has finished; reuse its scratch texture for shared face transfers.
    _VelocityPredicted[id]=float4(faceFlux(id,int3(1,0,0),_Cell.x),faceFlux(id,int3(0,1,0),_Cell.y),faceFlux(id,int3(0,0,1),_Cell.z),0);
}
[numthreads(8,4,8)] void PredictDensity(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return;
    // Donor budget keeps the sum of all outgoing face transfers positive at large CFL.
    // The budget is shared across faces, so the receiver gets exactly what the donor loses.
    int3 p=id;
    float3 outgoing=float3(max(0,cachedFlux(p,0))-min(0,cachedFlux(p-int3(1,0,0),0)),
        max(0,cachedFlux(p,1))-min(0,cachedFlux(p-int3(0,1,0),1)),
        max(0,cachedFlux(p,2))-min(0,cachedFlux(p-int3(0,0,1),2)));
    _Predicted[id]=min(1,densityAt(id)/max(1e-8,_Dt*(outgoing.x+outgoing.y+outgoing.z)));
}
float budgetedFlux(int3 left,int3 axis,float spacing)
{
    float flux=cachedFlux(left,axis.x!=0?0:(axis.y!=0?1:2));
    int3 donor=flux>=0?left:left+axis;
    return flux*_PredictRead.Load(int4(clampCell(donor),0));
}
[numthreads(8,4,8)] void CorrectDensity(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return;
    int3 p=id;
    float net=budgetedFlux(p,int3(1,0,0),_Cell.x)-budgetedFlux(p-int3(1,0,0),int3(1,0,0),_Cell.x)
        +budgetedFlux(p,int3(0,1,0),_Cell.y)-budgetedFlux(p-int3(0,1,0),int3(0,1,0),_Cell.y)
        +budgetedFlux(p,int3(0,0,1),_Cell.z)-budgetedFlux(p-int3(0,0,1),int3(0,0,1),_Cell.z);
    float d=max(0,densityAt(p)-_Dt*net);
    // Boundary supply is independent of optional interior shape recovery.
    float edge=min(min(uv(id).x,1-uv(id).x)*_Size.x,min(uv(id).z,1-uv(id).z)*_Size.z);
    float supply=(1-smoothstep(.3,1.0,edge))*(1-smoothstep(_Fluid.z*.25,_Fluid.z,uv(id).y*_Size.y));
    d=lerp(d,max(d,supply),1-exp(-_Fluid.w*_Dt));
    float3 pos=world(id);
    if(_RestRecovery>0)
    {
        float activity=_CoordinatesA.Load(int4(p,0)).w;
        // Include this tick's sources before the advected marker is updated.
        for(int s=0;s<_SourceCount;s++)
        {
            float speed=length(_Velocities[s].xyz);
            if(_Shapes[s].w<0 && speed<.01) speed=5;
            float coupling=_Shapes[s].w<0?1:saturate(_Shapes[s].z);
            activity=max(activity,sourceWeight(pos,s)*saturate(speed*.5)*coupling);
        }
        // Recovery resumes gently as the transported wake fades, never snapping/resetting velocity.
        activity=max(activity,puffActivity(pos));
        float quiet=1-smoothstep(.02,.2,activity);
        d=lerp(d,_RestDensity[id],1-exp(-_RestRecovery*quiet*_Dt));
    }
    for(int i=0;i<_SourceCount;i++) if(_Shapes[i].w>0)
    {
        float3 q=pos-_Sources[i].xyz; q.y-=clamp(q.y,0,_Shapes[i].y);
        float core=1-smoothstep(_Shapes[i].x*.6,_Shapes[i].x*1.15,length(q));
        d*=exp(-core*_Shapes[i].w*_Dt*18);
    }
    d+=puffDeposit(pos,false);
    _DensityOut[id]=blocked(id)?0:max(0,d);
}
float cumulusDetailRatio(float3 a,float3 b)
{
    float blend=1-abs(frac(_SimTime/6)*2-1);
    float4 aShape=_CumulusShape.SampleLevel(sampler_linear_clamp,a/_Size,0);
    float4 bShape=_CumulusShape.SampleLevel(sampler_linear_clamp,b/_Size,0);
    float width=max(.006,_Cumulus.y*.028), filter=max(.003,min(_Cell.x,min(_Cell.y,_Cell.z))*.5);
    float distanceA=aShape.z*width, distanceB=bShape.z*width;
    float variance=width*width+filter*filter;
    float coverageA=exp(-.5*distanceA*distanceA/variance)*width*width/variance*aShape.w;
    float coverageB=exp(-.5*distanceB*distanceB/variance)*width*width/variance*bShape.w;
    aShape.x=max(aShape.x,_Cumulus.w*coverageA);
    bShape.x=max(bShape.x,_Cumulus.w*coverageB);
    // Keep normalization inside each map so an empty partner cannot cancel its fade.
    return lerp(min(4,bShape.x/max(.005,bShape.y)),min(4,aShape.x/max(.005,aShape.y)),blend);
}
float densityForLight(float3 q)
{
    float d=_Density.SampleLevel(sampler_linear_clamp,q,0);
    if(_Cumulus.x>.5 && _Cumulus.x<1.5)
    {
        if(any(q<0)||any(q>1)) return 0;
        return d*cumulusDetailRatio(_CoordinatesA.SampleLevel(sampler_linear_clamp,q,0).xyz,_CoordinatesB.SampleLevel(sampler_linear_clamp,q,0).xyz);
    }
    else return d+(_Cumulus.x>1.5?_PuffDensity.SampleLevel(sampler_linear_clamp,q,0):0);
}
[numthreads(8,4,8)] void LightVolume(uint3 id : SV_DispatchThreadID)
{
    if(invalid(id)) return;
    float3 p=uv(id); float optical=0; bool sunBlocked=false;
    for(int i=0;i<12;i++)
    {
        p+=_LightDirection*.16/_Size;
        if(any(p<0)||any(p>1)) break;
        if(_Solid[clampCell((int3)(p*_Resolution))]>.5) { optical+=8; sunBlocked=true; break; }
        optical+=densityForLight(p)*.16*_Extinction;
    }
    float3 localLight=0;
    for(int j=0;j<_LocalLightCount;j++)
    {
        float3 delta=_LocalLightPositions[j].xyz-world(id); float d=length(delta);
        float attenuation=pow(saturate(1-d/_LocalLightPositions[j].w),2)/(1+d*d);
        // Outside the finite light range the contribution is exactly zero.
        // Avoid four density/obstacle shadow samples for every unaffected voxel.
        if(_ReferenceWork==0 && attenuation<=0) continue;
        // Short shadow march prevents light bleeding through obstacle boxes.
        float transmission=1;
        for(int s=1;s<=4;s++)
        {
            float3 q=uv(id)+delta/_Size*(s/5.0);
            if(any(q<0)||any(q>1)) continue;
            if(_Solid[clampCell((int3)(q*_Resolution))]>.5) {transmission=0;break;}
            transmission*=exp(-densityForLight(q)*d*.2*_Extinction*.6);
        }
        // A broader scattering lobe fills dense cloud cores; solid occlusion stays zero.
        if(_Cumulus.x>.5) transmission=.35*transmission+.65*pow(max(0,transmission),.15);
        localLight+=_LocalLightColors[j].rgb*attenuation*transmission;
    }
    float directional=exp(-optical);
    // Approximate diffuse multiple scattering without another shadow march.
    if(_Cumulus.x>.5) directional=sunBlocked?0:.35*directional+.65*exp(-optical*.15);
    _Lighting[id]=float4(localLight,directional);
}

#include "FogPlanar.hlsl"

// Rebuilt once per simulation tick, not once per ray step. The two volumes interpolate in rendering.
[numthreads(8,4,8)] void ClearPuffs(uint3 id:SV_DispatchThreadID)
{
    if(!invalid(id)) _PuffDensityOut[id]=0;
}

[numthreads(8,4,8)] void BuildProceduralPuffs(uint3 id:SV_DispatchThreadID)
{
    if(invalid(id)) return;
    float3 pos=world(id);float body;float4 sources;
    proceduralField(pos,body,sources);
    float activity=_PuffPlanar!=0?_PCoordA.SampleLevel(sampler_linear_clamp,uv(id).xz,0).w:_CoordinatesA.SampleLevel(sampler_linear_clamp,uv(id),0).w;
    bool blocked=solidAt(pos)>.5;
    _PuffDensityOut[id]=blocked?0:body*(1-saturate(activity)*.4);
    _ProceduralSourcesOut[id]=blocked?0:sources;
}
